---
import '../styles/global.css';

const {
  title = 'Karan Kalra — Game Programmer & Developer',
  description = 'Portfolio of gameplay programming,game AI, rendering and software projects.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c12" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>KARAN <span>KALRA</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#projects`}>Projects</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}contact/`}>Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Karan Kalra</span>
      <span></span>
    </footer>
  </body>
</html>