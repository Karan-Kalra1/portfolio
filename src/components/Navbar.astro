---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;

const links = [
  { href: `${base}`, label: 'Projects' },
  { href: `${base}about/`, label: 'About' },
  { href: `${base}contact/`, label: 'Contact' },
];
---

<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href={base} aria-label="Karan home">
      <span class="brand-mark">K<span>.</span></span>
      <span class="brand-name">Karan<span class="brand-dot">/</span>Portfolio</span>
    </a>

    <nav aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'nav-link',
            {
              active:
                currentPath === link.href ||
                (link.href !== base && currentPath.startsWith(link.href)),
            },
          ]}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a class="nav-cta" href={`${base}contact/`}>
      Let's talk <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>