---
const currentPath = Astro.url.pathname;
const links = [{ href: '/', label: 'Projects' }, { href: '/about/', label: 'About' }, { href: '/contact/', label: 'Contact' }];
---
<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Karan home"><span class="brand-mark">K<span>.</span></span><span class="brand-name">Karan<span class="brand-dot">/</span>Portfolio</span></a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href} class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="nav-cta" href="/contact/">Let's talk <span aria-hidden="true">↗</span></a>
  </div>
</header>
