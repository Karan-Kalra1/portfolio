
---
import type { Project } from '../data/projects';

const { project } = Astro.props as { project: Project };
const cover = project.media[0];

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const assetUrl = (src: string) => {
  if (/^(https?:)?\/\//i.test(src) || src.startsWith('data:') || src.startsWith('blob:')) {
    return src;
  }

  const path = src.replace(/^\/+/, '');
  const basePath = base.replace(/^\/+|\/+$/g, '');

  if (basePath && (path === basePath || path.startsWith(`${basePath}/`))) {
    return `/${path}`;
  }

  return `${base}${path}`;
};
---

<a class="project-card" href={`${base}projects/${project.slug}/`}>
  <div class="project-card-media">
    {project.coverImage ? (
      <img
        src={assetUrl(project.coverImage.src)}
        alt={project.coverImage.alt}
        loading="lazy"
      />
    ) : cover ? (
      cover.type === 'video' ? (
        <video
          src={assetUrl(cover.src)}
          muted
          autoplay
          loop
          playsinline
        />
      ) : cover.type === 'embed' ? (
        <div class="media-fallback">
          <span>↗</span>
          <small>Interactive media</small>
        </div>
      ) : (
        <img
          src={assetUrl(cover.src)}
          alt={cover.alt}
          loading="lazy"
        />
      )
    ) : (
      <div class="media-fallback">
        <span>↗</span>
        <small>Play in browser</small>
      </div>
    )}

    <span class="project-card-index">{project.category}</span>
    <span class="project-card-arrow" aria-hidden="true">↗</span>
  </div>

  <div class="project-card-copy">
    <div class="project-card-heading">
      <h3>{project.title}</h3>
      <span>{project.year}</span>
    </div>

    <p>{project.shortDescription}</p>

    <div class="tag-list">
      {project.tech.slice(0, 4).map((tech) => (
        <span class="tag">{tech}</span>
      ))}
    </div>
  </div>
</a>
