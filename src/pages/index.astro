---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, tools } from '../data/projects';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MainLayout>
  <section class="home-intro wrap">
    <div class="eyebrow">
      <span class="status-dot"></span>
      GAME PROGRAMMING · SOFTWARE DEVELOPMENT
    </div>

    <h1><span class="gradient-text">Hello, I'm Karan</span></h1>
    <p class="intro-copy">I'm a game programming student interested in gameplay systems, game AI, game engines and graphics programming.</p>

    <div class="intro-links">
      <a class="text-link" href={`${base}#projects`}>
        Explore projects <span>↓</span>
      </a>
      <a class="text-link muted-link" href={`${base}about/`}>
        More about me <span>↗</span>
      </a>
    </div>
  </section>

  <section class="projects-section wrap" id="projects">
    <div class="section-heading">
      <div>
        <div class="eyebrow"></div>
        <h2>My Projects<span class="accent-dot"></span></h2>
      </div>
      <p>From low-level rendering to gameplay AI and multiplayer systems.</p>
    </div>

    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="tools-section wrap">
    <div class="section-heading">
      <div>
        <div class="eyebrow">MY TOOLKIT</div>
        <h2>Tools I use<span class="accent-dot"></span></h2>
      </div>
      <p>Languages, engines and tools used across my projects</p>
    </div>

    <div class="tools-grid">
      {tools.map((tool) => <span class="tool-chip">{tool}</span>)}
    </div>
  </section>
</MainLayout>