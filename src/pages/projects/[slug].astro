---
import MainLayout from '../../layouts/MainLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const contentLabel = project.contributions ? 'My contributions' : 'Key features';
const base = import.meta.env.BASE_URL;
const assetUrl = (src: string) => {
  if (/^(https?:)?\/\//.test(src) || src.startsWith('data:')) {
    return src;
  }

  return `${base}${src.replace(/^\/+/, '')}`;
};
---

<MainLayout
  title={`${project.title} — Karan Kalra`}
  description={project.shortDescription}
>
  <article class="project-detail wrap">
    <a class="back-link" href={`${base}#projects`}>← All projects</a>

    <header class="detail-header">
      <div class="eyebrow">
        {project.category}
        <span class="eyebrow-separator">/</span>
        {project.year}
      </div>

      <h1>{project.title}</h1>
      <p class="detail-lede">{project.shortDescription}</p>

      <div class="detail-actions">
        <a
          class="button button-primary"
          href={project.repo}
          target="_blank"
          rel="noreferrer"
        >
          {project.externalUrl ? 'View project on itch.io' : 'View source on GitHub'}
          <span>↗</span>
        </a>

        {project.demoUrl && !project.demoUrl.includes('REPLACE-') && (
          <a
            class="button button-secondary"
            href={project.demoUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open web build ↗
          </a>
        )}
      </div>
    </header>

    {project.media.length > 0 && (
      <section
        class="media-carousel"
        data-carousel
        aria-label={`${project.title} media gallery`}
      >
        <div class="carousel-stage">
          {project.media.map((item, i) => (
            <div
              class:list={['carousel-slide', i === 0 ? 'is-active' : '']}
              data-slide={i}
              aria-hidden={i !== 0}
            >
              {item.type === 'video' ? (
                <video src={assetUrl(item.src)} controls playsinline />
              ) : item.type === 'embed' ? (
                <iframe
                  src={item.src}
                  title={item.alt}
                  loading="lazy"
                  allow="fullscreen; autoplay; encrypted-media; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <img
                  src={assetUrl(item.src)}
                  alt={item.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              )}

              <div class="media-caption">{item.caption ?? item.alt}</div>
            </div>
          ))}

          {project.media.length > 1 && (
            <>
              <button
                class="carousel-arrow carousel-prev"
                type="button"
                aria-label="Previous media"
              >
                ←
              </button>
              <button
                class="carousel-arrow carousel-next"
                type="button"
                aria-label="Next media"
              >
                →
              </button>
            </>
          )}
        </div>

        <div class="carousel-footer">
          <span class="carousel-counter">
            <span data-current>01</span> / {String(project.media.length).padStart(2, '0')}
          </span>

          <div class="carousel-dots">
            {project.media.map((item, i) => (
              <button
                type="button"
                class:list={['carousel-dot', i === 0 ? 'is-active' : '']}
                data-go={i}
                aria-label={`Show media ${i + 1}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              />
            ))}
          </div>

          <span class="carousel-hint">USE ARROWS TO EXPLORE</span>
        </div>
      </section>
    )}

    {project.slug === 'programming4-digger' && (
      <section class="web-build-section">
        <div class="section-heading compact-heading">
          <div>
            <div class="eyebrow">Might take a bit to load</div>
            <h2>Web build<span class="accent-dot"></span></h2>
          </div>
          <a
            class="text-link"
            href={project.demoUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open in new tab ↗
          </a>
        </div>

        <div class="web-build-frame">
          <iframe
            src={project.demoUrl}
            title="Digger web build"
            loading="lazy"
            allow="fullscreen; autoplay"
            allowfullscreen
          />
        </div>
      </section>
    )}

    <div class="detail-columns">
      <section class="detail-description">
        <div class="eyebrow">OVERVIEW</div>
        <h2>About the project<span class="accent-dot">.</span></h2>
        <p>{project.description}</p>

        <div class="tech-stack">
          <h3>Tech stack</h3>
          <div class="tag-list">
            {project.tech.map((tech) => <span class="tag">{tech}</span>)}
          </div>
        </div>
      </section>

      <section class="detail-info">
        <div class="tabs" role="tablist" aria-label="Project information">
          <button
            class="tab is-active"
            type="button"
            role="tab"
            aria-selected="true"
            data-tab="main"
          >
            {contentLabel}
          </button>
          <button
            class="tab"
            type="button"
            role="tab"
            aria-selected="false"
            data-tab="stack"
          >
            Tech stack
          </button>
        </div>

        <div class="tab-panel" data-panel="main">
          <ul class="feature-list">
            {(project.contributions ?? project.features).map((feature) => (
              <li>
                <span class="feature-marker">↗</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="tab-panel" data-panel="stack" hidden>
          <ul class="feature-list">
            {project.tech.map((tech) => (
              <li>
                <span class="feature-marker">✳</span>
                <span>{tech}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <div class="detail-bottom-link">
      <span>Want to dig into the implementation?</span>
      <a
        class="text-link"
        href={project.repo}
        target="_blank"
        rel="noreferrer"
      >
        Explore the repository ↗
      </a>
    </div>
  </article>

  <script is:inline>
    document.querySelectorAll('[data-carousel]').forEach((carousel) => {
      const slides = [...carousel.querySelectorAll('[data-slide]')];
      const dots = [...carousel.querySelectorAll('[data-go]')];
      const counter = carousel.querySelector('[data-current]');
      let current = 0;

      const show = (index) => {
        current = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          slide.classList.toggle('is-active', i === current);
          slide.setAttribute('aria-hidden', String(i !== current));
        });

        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === current);
          dot.setAttribute('aria-pressed', String(i === current));
        });

        if (counter) {
          counter.textContent = String(current + 1).padStart(2, '0');
        }
      };

      carousel.querySelector('.carousel-prev')
        ?.addEventListener('click', () => show(current - 1));

      carousel.querySelector('.carousel-next')
        ?.addEventListener('click', () => show(current + 1));

      dots.forEach((dot) => {
        dot.addEventListener('click', () => show(Number(dot.dataset.go)));
      });

      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
    });

    document.querySelectorAll('[data-tab]').forEach((button) => {
      button.addEventListener('click', () => {
        const root = button.closest('.detail-info');

        root.querySelectorAll('[data-tab]').forEach((tab) => {
          const active = tab === button;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
        });

        root.querySelectorAll('[data-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== button.dataset.tab;
        });
      });
    });
  </script>
</MainLayout>